# ============================================================
# 比赛资讯助手 - 环境变量模板
# 复制本文件为 .env 并填入真实值：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，绝不会被提交到 git。
# 所有值均为可选；留空则使用 docker-compose.yml 中的默认值。
# ============================================================

# ---- 时区与定时 ----
# 扫描执行的时区
APP_TIMEZONE=Asia/Shanghai
# 每日扫描的 cron 表达式（默认每天 20:00）
APP_SCHEDULE=0 20 * * *

# ---- 数据 ----
# SQLite 数据库路径（容器内）
DB_PATH=/data/competitions.db

# ---- 搜索发现（SearXNG）----
# SearXNG 实例地址
SEARXNG_URL=http://searxng:8080
# SearXNG 管理密钥（生产环境务必修改）
SEARXNG_SECRET=change-this-searxng-secret

# ---- 通知网关（Apprise）----
# Apprise API 通知地址（系统通知）
APPRISE_API_URL=http://apprise:8000/notify/
# Apprise 无状态收件人 URL，用于发送系统通知。
# 示例（QQ 邮箱 SMTP）：
#   APPRISE_STATELESS_URLS=mailtos://user@qq.com:授权码@smtp.qq.com?name=比赛资讯助手
# 具体格式参考 https://github.com/caronc/apprise
APPRISE_STATELESS_URLS=

# ---- Web 多用户界面 ----
# 启用 web 界面时填监听地址，如 :8080
WEB_LISTEN_ADDR=:8080
# 对外可访问的公网地址（用于邮件中的回链），如 https://your-domain.com
PUBLIC_BASE_URL=
# 登录会话签名密钥（务必设置随机长字符串）
APP_SECRET=
# Web 端发件人 Apprise URL（mailto 或 mailtos 格式）
APPRISE_SENDER_URL=

# ---- 大模型（AI 分析）----
# OpenAI 兼容 API 地址
OPENAI_BASE_URL=https://api.deepseek.com/v1
# API Key（必填，否则 AI 分析降级为纯规则引擎）
OPENAI_API_KEY=
# 模型名（DeepSeek 2026-07 后的新模型）
OPENAI_MODEL=deepseek-v4-flash

# ---- 数据保留（可选）----
# 是否启用清理
CLEANUP_ENABLED=true
# 观察记录保留天数
OBSERVATION_RETENTION_DAYS=30
# 已结束赛事正文保留天数
CLOSED_COMPETITION_CONTENT_RETENTION_DAYS=180
# 过期验证码/会话保留天数
EXPIRED_AUTHENTICATION_RETENTION_DAYS=7
