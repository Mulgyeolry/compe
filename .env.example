# 复制为 .env 后填写。不要把 .env 提交到版本库。
APP_TIMEZONE=Asia/Shanghai
APP_SCHEDULE="0 20 * * *"
CONFIG_FILE=./sources.yaml
DB_PATH=/data/competitions.db
SEARXNG_URL=http://searxng:8080
APPRISE_API_URL=http://apprise:8000/notify/

# 每次系统扫描结束后自动清洗可再生的历史数据。
CLEANUP_ENABLED=true
OBSERVATION_RETENTION_DAYS=30
CLOSED_COMPETITION_CONTENT_RETENTION_DAYS=180
NOTIFICATION_BODY_RETENTION_DAYS=180
EXPIRED_AUTH_RETENTION_DAYS=7

# 多用户网页。WEB_LISTEN_ADDR 留空时保持原来的单用户、无网页模式。
# 公网部署建议在反向代理后使用 HTTPS，并把 PUBLIC_BASE_URL 改成实际域名。
WEB_LISTEN_ADDR=:8080
WEB_PORT=8080
PUBLIC_BASE_URL=http://你的服务器公网IP:8080
# 至少 32 个随机字符。可运行：openssl rand -hex 32
APP_SECRET=

# 三项齐全时启用大模型；任一为空时使用纯规则模式。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Apprise 邮件 URL。用户名、密码和收件人中的特殊字符需要 URL 编码。
# QQ 邮箱示例：mailtos://发件邮箱:授权码@smtp.qq.com:465/?to=收件邮箱&from=发件邮箱&mode=ssl
# 163 邮箱示例：mailtos://发件邮箱:授权码@smtp.163.com:465/?to=收件邮箱&from=发件邮箱&mode=ssl
APPRISE_STATELESS_URLS=

# 多用户模式的发件邮箱 URL。程序会安全替换 to 参数为已验证用户邮箱。
# 可以与上面的 URL 使用同一发件账号，但不要在这里固定真实收件人。
APPRISE_SENDER_URL=

# 仅供 SearXNG 内部服务使用，请在公开部署时换成随机长字符串。
SEARXNG_SECRET=change-this-searxng-secret
